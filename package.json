    "audit:mojibake-data": "node --env-file-if-exists=.env scripts/audit-mojibake-data.mjs",
    "audit:mojibake-sanitize": "node --env-file-if-exists=.env scripts/sanitize-mojibake-data.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:proposal-pdf": "node scripts/test-deterministic-proposal-pdf.mjs",
    "test:server-pdf": "node scripts/test-server-pdf.mjs",
    "test:watch": "vitest"
