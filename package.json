    "dev:api": "node --env-file=.env --watch server/index.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "start": "node --env-file=.env server/index.mjs",
    "auth:create-admin": "node --env-file=.env scripts/create-admin-user.mjs",
    "audit:e2e": "node --env-file-if-exists=.env scripts/audit-homologation-flow.mjs",
