PGHOST=89.116.214.65
PGPORT=5432
PGDATABASE=atenza
PGUSER=root
PGPASSWORD="coloque_sua_senha_aqui"

# Storage documental SaaS (Cloudflare R2 opcional)
RUNTIME_ENV=homologacao
# Use "r2" somente quando bucket, account id e chaves estiverem configurados.
# Sem credenciais completas, a aplicacao mantem fallback seguro no banco.
DOCUMENT_STORAGE_PROVIDER=database
R2_BUCKET_DOCUMENTS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Assistencia opcional para criar rascunhos de propostas a partir de PDF.
# A chave permanece somente no backend; nunca a exponha no frontend.
OPENAI_PROPOSAL_ASSIST_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
